QWidget {
    background-color: #f5f6f8;
    color: #1f2933;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

#navigation {
    background-color: #1f2933;
    border: none;
    outline: 0;
    padding: 12px 8px;
}

#navigation::item {
    color: #cbd2d9;
    padding: 12px 16px;
    border-radius: 6px;
}

#navigation::item:selected {
    background-color: #3e4c59;
    color: #ffffff;
}

#navigation::item:hover {
    background-color: #2f3b45;
}

#pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #1f2933;
}

#pageSubtitle {
    font-size: 13px;
    color: #616e7c;
}

#hoursSummary {
    background-color: #ffffff;
    border: 1px solid #e4e7eb;
    border-radius: 8px;
}

#summaryValue {
    font-size: 20px;
    font-weight: 600;
    color: #1f2933;
}

#summaryCaption {
    font-size: 12px;
    color: #616e7c;
}

#placeholder {
    background-color: #ffffff;
    border: 1px dashed #cbd2d9;
    border-radius: 8px;
    padding: 24px;
    color: #7b8794;
}

QStatusBar {
    background-color: #e4e7eb;
    color: #52606d;
}
